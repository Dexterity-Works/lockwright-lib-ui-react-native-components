{
  "name": "lockwright-lib-ui-react-native-components",
  "version": "0.0.41",
  "type": "module",
  "description": "React native components for Lockwright",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./components": "./src/components/index.ts",
    "./components/*": "./src/components/*/index.ts",
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/components/*.tsx",
    "./tailwind.css": "./src/theme/tailwind-theme.css",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "license": "Apache-2.0",
  "scripts": {
    "generate-tokens": "node scripts/generate-tokens.mjs",
    "generate-icons:web": "svgr --out-dir src/icons/components src/icons/assets",
    "generate-icons:native": "svgr --native --ext native.tsx --no-index --out-dir src/icons/components src/icons/assets",
    "generate-icons": "npm run generate-icons:web && npm run generate-icons:native && node scripts/generate-icon-story.mjs",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "test": "node --test scripts/lockwright-tokens.test.js && jest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.native.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:native": "cd storybook-native && npx expo start",
    "storybook:native:ios": "cd storybook-native && npx expo run:ios",
    "storybook:native:android": "cd storybook-native && npx expo run:android"
  },
  "peerDependencies": {
    "@gorhom/bottom-sheet": "^5.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "^2.24.0",
    "react-native-reanimated": "^3.17.4",
    "react-native-svg": "15.11.2",
    "@react-native-community/datetimepicker": "^8.4.4"
  },
  "peerDependenciesMeta": {
    "react-native": { "optional": true },
    "react-native-gesture-handler": { "optional": true },
    "react-native-reanimated": { "optional": true },
    "react-native-svg": { "optional": true },
    "@gorhom/bottom-sheet": { "optional": true },
    "@react-native-community/datetimepicker": { "optional": true }
  },
  "devDependencies": {
    "@babel/core": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-react": "^7.28.5",
    "@react-native/babel-preset": "^0.78.1",
    "@storybook/addon-a11y": "^10.2.13",
    "@storybook/addon-docs": "^10.2.13",
    "@storybook/react-vite": "^10.2.13",
    "@stylexjs/babel-plugin": "^0.15.4",
    "@svgr/cli": "^8.1.0",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.14",
    "@types/react-native": "^0.72.8",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.4",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.5",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-reanimated": "~3.17.4",
    "react-native-svg": "15.11.2",
    "react-test-renderer": "19.0.0",
    "shx": "^0.4.0",
    "storybook": "^10.2.13",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "react-strict-dom": "^0.0.55"
  }
}
